# Coverage configuration for SCMS-NF-005 (at least 70% line coverage).
#
# What is measured: the application and its configuration.
#
# What is left out, and why each one would otherwise distort the
# number rather than inform it:
#
#   tests.py      measuring the tests inflates the figure with code
#                 that is by definition executed. It is the largest
#                 file in the project, so including it would add
#                 roughly twenty points of coverage that say nothing
#                 about how well the application is tested.
#   migrations/   generated by Django from model changes. Migration
#                 0011 is hand-written and does carry logic, but its
#                 behaviour is asserted directly by
#                 DatabaseLevelAuditGuardTests, which is a stronger
#                 check than a line-execution count.
#   manage.py     a launcher; its body runs only outside the tests.
#   wsgi/asgi     deployment entry points, never imported by a test.
#   settings_local  the SQLite convenience module, which the suite
#                 does import locally but not under CI, so counting
#                 it would make the figure depend on which database
#                 the run used.

[run]
source = complaints,config
branch = False
omit =
    */migrations/*
    */tests.py
    */manage.py
    */wsgi.py
    */asgi.py
    */settings_local.py

[report]
precision = 1
show_missing = True
skip_covered = False

# Lines that exist for a case the suite is not meant to reach.
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
